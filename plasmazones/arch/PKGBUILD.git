pkgname=plasmazones-git
# Placeholder — overwritten by pkgver() on every build. The fallback in
# pkgver() (if `git describe` fails on a shallow clone) must produce a
# version ≥ the canonical PKGBUILD's pkgver, or pacman silently treats
# -git as older than the stable package.
pkgver=3.0.0.r0.g0000000
pkgrel=1
pkgdesc="Window snapping, tiling and scrolling for KDE Plasma (git version)"
arch=('x86_64')
url="https://github.com/phosphor-works/PlasmaZones"
license=('GPL-3.0-or-later' 'LGPL-2.1-or-later' 'MIT' 'BSL-1.0' 'BSD-3-Clause' 'CC0-1.0' 'HPND-sell-variant')

# KWin: minimum version, NOT an exact pin. The kwin-effect plugin's IID embeds
# KWin's exact upstream version string and KWin refuses to load an effect whose
# IID doesn't match its own version (even across patch bumps, e.g. 6.7.0 ->
# 6.7.1). An exact `kwin=<ver>` pin, however, makes pacman hold KWin back on
# -Syu whenever a newer KWin lands before this package is rebuilt, stranding the
# desktop in a half-upgraded Plasma ("No KScreen backend found", black screen).
# A mismatched effect is harmless — KWin reads the IID from plugin metadata and
# never loads a non-matching effect, so the .so stays inert; only the drag
# overlay is missing until a rebuild. Core tiling runs in the daemon +
# layer-shell QPA plugin and is independent of the effect.
depends=(
    'qt6-base'
    'qt6-declarative'
    'qt6-shadertools'
    'qt6-svg'
    'kconfig'
    'kconfigwidgets'
    'kcmutils'
    'kglobalaccel'
    'kcolorscheme'
    'kirigami'
    'qt6-wayland'
    'kwin>=6.7.0'
)
makedepends=(
    'git'
    'cmake'
    'extra-cmake-modules'
    'ninja'
    'qt6-tools'
    'kwin'
    'wayland'
    'vulkan-headers'
    'vulkan-icd-loader'
)
optdepends=(
    'plasma-activities: activity-based layouts'
    'hwdata: readable GPU names in the rendering device picker'
)
provides=('plasmazones')
conflicts=('plasmazones' 'plasmazones-bin')
# The git checkout, then the archives the build compiles in: the phosphor-libs
# and phosphor-engine-libs commits, the branding release and the surface packs commit pinned (version,
# URL and SHA-256) in
# cmake/PlasmaZonesDependencies.cmake, and the third-party sources that
# phosphor-libs commit pins in its own cmake/PhosphorDependencies.cmake.
# The dep-pins rule of PlasmaZones' check-conventions.py fails when the URLs and
# hashes here stop matching the pin. A pin bump in PlasmaZones lands here in the
# same change set, so a clone of the default branch and these archives agree.
# They stay archives (noextract): build() hands $srcdir to CMake as
# PHOSPHOR_DEPS_ARCHIVES, which checks each hash and unpacks it itself, so the
# build never reaches the network. The last two entries are the pacman hook and
# its script, which are files of this directory and not of PlasmaZones.
source=(
    "$pkgname::git+$url.git"
    "phosphor-libs-bf8bf88bb24e29475b1b7adf0abefd7c7fbd05dd.tar.gz::https://github.com/phosphor-works/phosphor-libs/archive/bf8bf88bb24e29475b1b7adf0abefd7c7fbd05dd.tar.gz"
    "luau-0.745.tar.gz::https://github.com/luau-lang/luau/archive/refs/tags/0.745.tar.gz"
    "jsoncons-1.10.0.tar.gz::https://github.com/danielaparker/jsoncons/archive/refs/tags/v1.10.0.tar.gz"
    "phosphor-branding-0.3.1.tar.gz::https://github.com/phosphor-works/branding/releases/download/v0.3.1/phosphor-branding-0.3.1.tar.gz"
    "phosphor-surface-packs-572e2240ef306d48650ed45ba6672af5ab31e75f.tar.gz::https://github.com/phosphor-works/phosphor-surface-packs/archive/572e2240ef306d48650ed45ba6672af5ab31e75f.tar.gz"
    "phosphor-components-0054f742fb5527475a51cc2f196e14dfd77d677d.tar.gz::https://github.com/phosphor-works/phosphor-components/archive/0054f742fb5527475a51cc2f196e14dfd77d677d.tar.gz"
    "phosphor-engine-libs-ab293743d925847d4e29573228a6b9a862c886fd.tar.gz::https://github.com/phosphor-works/phosphor-engine-libs/archive/ab293743d925847d4e29573228a6b9a862c886fd.tar.gz"
    "kbuildsycoca.hook"
    "plasmazones-refresh-sycoca"
)
noextract=('phosphor-libs-bf8bf88bb24e29475b1b7adf0abefd7c7fbd05dd.tar.gz' 'luau-0.745.tar.gz' 'jsoncons-1.10.0.tar.gz' 'phosphor-branding-0.3.1.tar.gz' 'phosphor-surface-packs-572e2240ef306d48650ed45ba6672af5ab31e75f.tar.gz' 'phosphor-components-0054f742fb5527475a51cc2f196e14dfd77d677d.tar.gz' 'phosphor-engine-libs-ab293743d925847d4e29573228a6b9a862c886fd.tar.gz')
sha256sums=(
    'SKIP'
    '195cf9dc8d49b7d425ad6e6ca6e8b09af21310940ff0d9aa442c145e735da7ca' # phosphor-libs-bf8bf88bb24e29475b1b7adf0abefd7c7fbd05dd.tar.gz
    '53c22773bace6cabbabaead576fbc08d11a0317fce11a3dbf9d027dda6849248' # luau-0.745.tar.gz
    'c829350a2eece662beb378143e2ab1c1cbb07d703687bf168626665a8a7d8bc1' # jsoncons-1.10.0.tar.gz
    'd6ec9261d4391148f5c21dfb02be410214d42ea675f1558a826042d63f495094' # phosphor-branding-0.3.1.tar.gz
    '2fb063f95503dcca9b23c2905213940f1f4aa8701623f1020c695335dd90475e' # phosphor-surface-packs-572e2240ef306d48650ed45ba6672af5ab31e75f.tar.gz
    '68a3f9e6e997dfce51d03544e310a5efad45fcfa40fbc73fa70f48cce44b8285' # phosphor-components-0054f742fb5527475a51cc2f196e14dfd77d677d.tar.gz
    '83d31714fd68de70c8dcabbf3db4559547b76d636748951322f87fd248e75a97' # phosphor-engine-libs-ab293743d925847d4e29573228a6b9a862c886fd.tar.gz
    'df64d66dffb8a711e4207cf0e297da3b6b586ddde10ab4f33dca00ede13fca0e' # kbuildsycoca.hook
    'd8066b6186c622bfc2e3f0ea59cc01a6c58869eab96219106a1b546b0664530e' # plasmazones-refresh-sycoca
)
install=plasmazones.install

pkgver() {
    cd "$pkgname"
    # Prefer `git describe`; fall back to "<project-version>.r<count>.g<sha>"
    # so we still produce a sortable version on shallow clones. The project
    # version is parsed from CMakeLists.txt (rather than hand-bumped here)
    # so a release bump doesn't silently leave the -git fallback ordering
    # wrong against the new -stable pkgver.
    #
    # Branch explicitly on whether describe succeeded — piping through
    # sed swallows the failure (sed exits 0 on empty stdin) and the
    # fallback printf never fires, leaving pkgver() empty and makepkg
    # aborting with "pkgver is not allowed to be empty".
    local cmake_version describe
    cmake_version=$(sed -n 's/^project(PlasmaZones VERSION \([^ )]*\).*/\1/p' CMakeLists.txt)
    : "${cmake_version:=3.0.0}"
    if describe=$(git describe --long --tags 2>/dev/null) && [[ -n "$describe" ]]; then
        printf '%s\n' "$describe" | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
    else
        printf "%s.r%s.g%s" "$cmake_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    fi
}

build() {
    cmake -B build -S "$pkgname" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DPHOSPHOR_DEPS_ARCHIVES="$srcdir" \
        -Wno-dev
    cmake --build build --parallel
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    # Install pacman hook to auto-refresh sycoca cache
    install -Dm644 "$srcdir/kbuildsycoca.hook" \
        "$pkgdir/usr/share/libalpm/hooks/plasmazones-kbuildsycoca.hook"
    install -Dm755 "$srcdir/plasmazones-refresh-sycoca" \
        "$pkgdir/usr/share/libalpm/scripts/plasmazones-refresh-sycoca"

    # License files — GPL-3.0-or-later (main) + LGPL-2.1-or-later
    # (the bundled Phosphor component libraries).
    install -Dm644 "$pkgname/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$pkgname/COPYING.LESSER" \
        "$pkgdir/usr/share/licenses/$pkgname/COPYING.LESSER"

    # `cmake --install` above also installs every Phosphor component
    # shared library plus its CMake config and headers; they ship
    # bundled with the main package.
}
